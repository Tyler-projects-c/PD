generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model compliance_requests {
  request_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_domain  String
  topic        String
  payload      Json
  received_at  DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  action_taken String?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  event_id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id         String    @db.Uuid
  shop_domain        String
  event_type         String
  product_id         String?
  surface            String?
  surface_ref        String?
  variant            String?
  position_shown     Int?
  order_id           String?
  revenue            Decimal?  @db.Decimal(12, 2)
  /// Webhook-confirmed per-line revenue from the orders/paid topic (authoritative;
  /// raw browser-reported `revenue` is never overwritten — see module doc in
  /// app/utils/order-verification.server.ts).
  verified_revenue   Decimal?  @db.Decimal(12, 2)
  /// pending: no orders/paid webhook seen yet. verified: webhook matched.
  /// mismatch: matched but differed by more than the rounding threshold.
  /// unverified: still no webhook after the 24h grace window.
  verification_status String    @default("pending")
  occurred_at        DateTime  @default(now()) @db.Timestamptz(6)
  verified_at        DateTime? @db.Timestamptz(6)
  shops              shops     @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)
  visitors           visitors  @relation(fields: [visitor_id], references: [visitor_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shop_domain, event_type], map: "idx_events_shop_type")
  @@index([shop_domain, surface, surface_ref], map: "idx_events_surface")
  @@index([visitor_id], map: "idx_events_visitor")
  @@index([shop_domain, verification_status, occurred_at])
}

/// Webhook-first verification ledger: orders/paid amounts parked here when the
/// webhook arrives BEFORE the browser's checkout_completed row exists (the
/// common race - webhook delivery beats the thank-you-page pixel). Keyed by
/// (shop_domain, order_id, product_id); persistEvent in app/routes/api.events.tsx
/// consumes rows on checkout insert and marks the new row verified/mismatch
/// immediately. Rows whose browser row arrives later are consumed and deleted
/// by the same path, so the ledger only holds genuinely unmatched lines.
model webhook_revenue_ledger {
  shop_domain  String
  order_id     String
  product_id   String
  /// Per-line authoritative amount, post-discount (webhook price x quantity
  /// minus discount_allocations - see app/utils/order-verification.server.ts).
  amount       Decimal @db.Decimal(12, 2)
  received_at  DateTime @default(now()) @db.Timestamptz(6)

  @@id([shop_domain, order_id, product_id])
  @@index([shop_domain, order_id], map: "idx_ledger_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model experiment_assignments {
  visitor_id    String   @db.Uuid
  shop_domain   String
  surface       String
  surface_ref   String
  experiment_id String   @db.Uuid
  variant       String
  assigned_at   DateTime @default(now()) @db.Timestamptz(6)
  shops         shops    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)
  visitors      visitors @relation(fields: [visitor_id], references: [visitor_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([visitor_id, surface, surface_ref])
  @@index([experiment_id], map: "idx_assignments_experiment")
  @@index([shop_domain, surface, surface_ref], map: "idx_assignments_shop_surface")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_surface_stats {
  product_id   String
  shop_domain  String
  surface      String
  surface_ref  String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  purchases    Int      @default(0)
  revenue      Decimal  @default(0) @db.Decimal(14, 2)
  last_updated DateTime @default(now()) @db.Timestamptz(6)
  products     products @relation(fields: [product_id, shop_domain], references: [product_id, shop_domain], onDelete: Cascade, onUpdate: NoAction)
  shops        shops    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, shop_domain, surface, surface_ref])
  @@index([shop_domain, surface, surface_ref], map: "idx_stats_shop_surface")
}

/// Durable backing for the Thompson daily-resample ranking cache
/// (app/utils/thompson-daily-cache.ts). One row per (visitor, surface, ref, UTC
/// day) holding the draw result — same grain as the key built by
/// buildDailyCacheKey + date_utc. Deleted with its shop on GDPR redact.
/// This table contains check constraints and requires additional setup for migrations.
model thompson_daily_rankings {
  visitor_id  String   @db.Uuid
  shop_domain String
  surface     String
  surface_ref String
  date_utc    String   @db.VarChar(10)
  ranking     String[]
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  shops       shops    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)
  visitors    visitors @relation(fields: [visitor_id], references: [visitor_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([visitor_id, shop_domain, surface, surface_ref, date_utc])
  @@index([shop_domain, surface, surface_ref], map: "idx_daily_rankings_surface")
}

model products {
  product_id            String
  shop_domain           String
  title                 String
  created_at            DateTime                @db.Timestamptz(6)
  inventory_available   Int                     @default(0)
  price                 Decimal                 @default(0) @db.Decimal(12, 2)
  tags                  String[]                @default([])
  is_pinned             Boolean                 @default(false)
  is_excluded           Boolean                 @default(false)
  launch_window_end     DateTime?               @db.Timestamptz(6)
  last_synced_at        DateTime                @default(now()) @db.Timestamptz(6)
  /// True when at least one variant is untracked OR continue-selling: the
  /// product is legitimately always purchasable, so the candidate filter must
  /// NOT require inventory_available > 0 for it (see
  /// app/utils/thompson-ranking.server.ts and the INVENTORY ROLLUP note on
  /// normalizeProduct in app/utils/product-sync.server.ts).
  always_available Boolean                @default(false)
  /// Set by product-sync (webhooks + reconciliation): product deleted in
  /// Shopify, or draft/archived, or absent from a reconciliation pull. The row
  /// is KEPT (it is the FK parent of product_surface_stats — deleting would
  /// destroy attribution history) but the product is unrankable.
  deleted_at            DateTime?               @db.Timestamptz(6)
  /// Canonical numeric inventory-item ids (Shopify) of this product's
  /// variants, for resolving inventory_levels/update webhooks (which carry
  /// only the inventory_item_id) without an Admin API round-trip.
  inventory_item_ids    String[]                @default([])
  product_surface_stats product_surface_stats[]
  shops                 shops                   @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, shop_domain])
  @@index([shop_domain], map: "idx_products_shop")
}

model shops {
  shop_domain            String                   @id
  access_token           String
  scopes                 String
  installed_at           DateTime                 @default(now()) @db.Timestamptz(6)
  uninstalled_at         DateTime?                @db.Timestamptz(6)
  /// Per-shop freshness stamp for the daily full-catalog product
  /// reconciliation pull (product-sync.server.ts), piggybacked on the first
  /// ranking request of a UTC day. Deliberately separate from
  /// products.last_synced_at: webhook upserts bump the latter and must NOT
  /// make the shop look reconciled.
  products_reconciled_at DateTime?                @db.Timestamptz(6)
  events                 events[]
  experiment_assignments experiment_assignments[]
  product_surface_stats  product_surface_stats[]
  products               products[]
  thompson_daily_rankings thompson_daily_rankings[]
  visitors               visitors[]
}

model visitors {
  visitor_id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_domain            String
  first_seen_at          DateTime                 @default(now()) @db.Timestamptz(6)
  events                 events[]
  experiment_assignments experiment_assignments[]
  thompson_daily_rankings thompson_daily_rankings[]
  shops                  shops                    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)

  @@index([shop_domain], map: "idx_visitors_shop")
}

model shopify_sessions {
  id                  String   @id @db.VarChar(255)
  shop                String   @db.VarChar(255)
  state               String   @db.VarChar(255)
  isOnline            Boolean
  scope               String?  @db.VarChar(1024)
  expires             Int?
  accessToken         String?  @db.VarChar(255)
  refreshToken        String?  @db.VarChar(255)
  refreshTokenExpires BigInt?
  userId              BigInt?
  firstName           String?  @db.VarChar(255)
  lastName            String?  @db.VarChar(255)
  email               String?  @db.VarChar(255)
  accountOwner        Boolean?
  locale              String?  @db.VarChar(255)
  collaborator        Boolean?
  emailVerified       Boolean?
}

model shopify_sessions_migrations {
  migration_name String @id @db.VarChar(255)
}

/// Revenue trust hardening (app/utils/order-verification.server.ts).
///
/// `events.verification_status` is deliberately modelled as TEXT + a DB-level
/// CHECK constraint rather than a Prisma enum: Prisma's schema language cannot
/// express CHECK constraints, and this database's canonical objects are raw-SQL
/// CHECK constraints captured in prisma/migrations/1_check_constraints (the
/// events model is already flagged "contains check constraints", same as
/// `events.event_type`). Declaring an enum here instead would make
/// `prisma migrate` create a PostgreSQL enum type that the migration does NOT
/// create -- i.e. schema/DB drift.
///
/// Canonical values (keep in sync with the CHECK constraint in
/// prisma/migrations/20260915120000_add_order_verification_fields/migration.sql
/// and with the status literals in app/utils/order-verification.server.ts):
///   'pending' | 'verified' | 'mismatch' | 'unverified'
