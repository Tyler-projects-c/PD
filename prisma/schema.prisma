generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model compliance_requests {
  request_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_domain  String
  topic        String
  payload      Json
  received_at  DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  event_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id     String   @db.Uuid
  shop_domain    String
  event_type     String
  product_id     String?
  surface        String?
  surface_ref    String?
  variant        String?
  position_shown Int?
  order_id       String?
  revenue        Decimal? @db.Decimal(12, 2)
  occurred_at    DateTime @default(now()) @db.Timestamptz(6)
  shops          shops    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)
  visitors       visitors @relation(fields: [visitor_id], references: [visitor_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shop_domain, event_type], map: "idx_events_shop_type")
  @@index([shop_domain, surface, surface_ref], map: "idx_events_surface")
  @@index([visitor_id], map: "idx_events_visitor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model experiment_assignments {
  visitor_id    String   @db.Uuid
  shop_domain   String
  surface       String
  surface_ref   String
  experiment_id String   @db.Uuid
  variant       String
  assigned_at   DateTime @default(now()) @db.Timestamptz(6)
  shops         shops    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)
  visitors      visitors @relation(fields: [visitor_id], references: [visitor_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([visitor_id, surface, surface_ref])
  @@index([experiment_id], map: "idx_assignments_experiment")
  @@index([shop_domain, surface, surface_ref], map: "idx_assignments_shop_surface")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_surface_stats {
  product_id   String
  shop_domain  String
  surface      String
  surface_ref  String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  purchases    Int      @default(0)
  revenue      Decimal  @default(0) @db.Decimal(14, 2)
  last_updated DateTime @default(now()) @db.Timestamptz(6)
  products     products @relation(fields: [product_id, shop_domain], references: [product_id, shop_domain], onDelete: Cascade, onUpdate: NoAction)
  shops        shops    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, shop_domain, surface, surface_ref])
}

model products {
  product_id            String
  shop_domain           String
  title                 String
  created_at            DateTime                @db.Timestamptz(6)
  inventory_available   Int                     @default(0)
  price                 Decimal                 @default(0) @db.Decimal(12, 2)
  tags                  String[]                @default([])
  is_pinned             Boolean                 @default(false)
  is_excluded           Boolean                 @default(false)
  launch_window_end     DateTime?               @db.Timestamptz(6)
  last_synced_at        DateTime                @default(now()) @db.Timestamptz(6)
  product_surface_stats product_surface_stats[]
  shops                 shops                   @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, shop_domain])
  @@index([shop_domain], map: "idx_products_shop")
}

model shops {
  shop_domain            String                   @id
  access_token           String
  scopes                 String
  installed_at           DateTime                 @default(now()) @db.Timestamptz(6)
  uninstalled_at         DateTime?                @db.Timestamptz(6)
  events                 events[]
  experiment_assignments experiment_assignments[]
  product_surface_stats  product_surface_stats[]
  products               products[]
  visitors               visitors[]
}

model visitors {
  visitor_id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_domain            String
  first_seen_at          DateTime                 @default(now()) @db.Timestamptz(6)
  events                 events[]
  experiment_assignments experiment_assignments[]
  shops                  shops                    @relation(fields: [shop_domain], references: [shop_domain], onDelete: Cascade, onUpdate: NoAction)

  @@index([shop_domain], map: "idx_visitors_shop")
}

model shopify_sessions {
  id                  String   @id @db.VarChar(255)
  shop                String   @db.VarChar(255)
  state               String   @db.VarChar(255)
  isOnline            Boolean
  scope               String?  @db.VarChar(1024)
  expires             Int?
  accessToken         String?  @db.VarChar(255)
  refreshToken        String?  @db.VarChar(255)
  refreshTokenExpires BigInt?
  userId              BigInt?
  firstName           String?  @db.VarChar(255)
  lastName            String?  @db.VarChar(255)
  email               String?  @db.VarChar(255)
  accountOwner        Boolean?
  locale              String?  @db.VarChar(255)
  collaborator        Boolean?
  emailVerified       Boolean?
}

model shopify_sessions_migrations {
  migration_name String @id @db.VarChar(255)
}
